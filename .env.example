# Copy these names into your local .env or the host's settings.
# Never commit real values. The full production list with notes is in
# documentation/production-environment.md.

# Local development with MySQL (visible in MySQL Workbench):
spring.profiles.active=local
SERVER_PORT=8081
DB_URL=jdbc:mysql://127.0.0.1:3306/salon_dbv2?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=replace-with-local-database-password

# Free Cloudinary account credentials. Never expose the API secret to the frontend.
CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-api-key
CLOUDINARY_API_SECRET=replace-with-api-secret

# Gmail: MAIL_PASSWORD is a Gmail App Password (16 letters, no spaces),
# never the normal account password. Port 465 uses SSL.
MAIL_DELIVERY=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_SSL_ENABLED=true
MAIL_STARTTLS=false
MAIL_USERNAME=replace-with-gmail-address
MAIL_PASSWORD=replace-with-gmail-app-password
MAIL_FROM=replace-with-gmail-address
MAIL_FROM_NAME=SalonHub

# Hosts that block SMTP (Render's free plan): send through the Brevo HTTPS API
# instead. Then MAIL_HOST, MAIL_PORT and MAIL_PASSWORD are not used.
# MAIL_DELIVERY=brevo
# BREVO_API_KEY=replace-with-brevo-api-key

# Links in emails, and the browser origins allowed to call the API.
FRONTEND_URL=http://localhost:5173
# CORS_ALLOWED_ORIGINS=https://your-frontend-domain

# Base64-encoded secret containing at least 32 random bytes.
JWT_SECRET=replace-with-base64-encoded-secret
# Use a separate high-entropy secret in deployed environments.
AUTH_CODE_SECRET=replace-with-at-least-32-random-characters

# Optional services.
ANTHROPIC_API_KEY=replace-with-claude-api-key
GOOGLE_MAPS_API_KEY=replace-with-google-routes-key
