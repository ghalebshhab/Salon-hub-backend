# Copy these names into your local environment or deployment secret manager.
# Never commit real values.

# Local development with MySQL (visible in MySQL Workbench):
spring.profiles.active=local
SERVER_PORT=8081
DB_URL=jdbc:mysql://127.0.0.1:3306/salon_dbv2?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=replace-with-local-database-password

# Production/MySQL alternative:
# DB_URL=jdbc:mysql://127.0.0.1:3306/salon_dbv2
# DB_USERNAME=root
# DB_PASSWORD=replace-with-database-password

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=replace-with-smtp-username
MAIL_PASSWORD=replace-with-smtp-app-password
MAIL_FROM=replace-with-verified-sender-address

# Use a separate high-entropy secret in deployed environments.
AUTH_CODE_SECRET=replace-with-at-least-32-random-characters

# Base64-encoded secret containing at least 32 random bytes.
JWT_SECRET=replace-with-base64-encoded-secret
JWT_EXPIRATION_MS=86400000
